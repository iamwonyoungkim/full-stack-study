<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 반드시 namespace 속성값을 Mapper 인터페이스와 동일한 이름을 줘야 한다. -->
<mapper namespace="org.scoula.board.mapper.BoardMapper">
    <insert id="create">
        insert into tbl_board(title, content, writer)
        values (#{title}, #{content}, #{writer})
        # LAST_INSERT_ID()는 MySQL에서 제공하는 함수로,
        # 마지막에 삽입된 행의 PK 값을 반환해준다.
        <selectKey resultType="Long" keyProperty="no" keyColumn="no" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <update id="update">
        update tbl_board set
            title = #{title},
            content = #{content},
            writer = #{writer},
            update_date = now()
        where no = #{no}
    </update>

    <delete id="delete">
        delete from tbl_board where no = #{no}
    </delete>

    <!-- id 속성값은 Mapper 인터페이스의 메서드의 이름과 일치하게 작성한다. -->
    <!--
        - resultType 속성값은 select 쿼리의 결과를 특정 클래스의 객체로 만들기 위해서 설정한다.
        - 원래는 org.scoula.board.domain.BoardVO처럼 작성해야 하지만,
          mybatis-config.xml에 typeAliases를 설정해뒀으므로 BoardVo처럼 작성할 수 있다.
    -->
    <!--
        <![CDATA[ SQL 문자열 ]]>
        - 이미 컴파일한 데이터임을 나타낸다. (문자열 속 <,> 태그 글자가 무시됨)
        - 태그 문자가 없다면 생략 가능
    -->
    <select id="getList" resultType="BoardVO">
        <![CDATA[
            select * from tbl_board
            order by no desc
        ]]>
    </select>

    <!-- get(select) 처리 -->
    <select id="get" resultMap="boardMap">
        select b.*, a.no as ano, a.bno, a.filename, a.path, a.content_type, a.size, a.reg_date a_reg_date
        FROM tbl_board b
            LEFT OUTER JOIN tbl_board_attachment a
            ON b.no = a.bno
        WHERE b.no = #{no}
        ORDER BY filename
    </select>

    <insert id="createAttachment">
        insert into tbl_board_attachment(filename, path, content_type, size, bno)
        values (#{filename}, #{path}, #{contentType}, #{size}, #{bno})
    </insert>

    <select id="getAttachmentList" resultType="BoardAttachmentVO">
        select * from tbl_board_attachment
        where bno = #{bno}
        order by filename
    </select>

    <select id="getAttachment" resultType="BoardAttachmentVO">
        select * from tbl_board_attachment
        where no = #{no}
    </select>

    <select id="getTotalCount" resultType="java.lang.Integer">
        SELECT count(*) FROM tbl_board
    </select>

    <!-- limit에 수식이 올 수는 없다. 미리 계산을 해두고 넣어야 한다. -->
    <select id="getPage" resultType="BoardVO">
        SELECT * FROM tbl_board ORDER BY no DESC
        LIMIT #{offset}, #{amount}
    </select>

    <delete id="deleteAttachment">
        delete from tbl_board_attachment
        where no = #{no}
    </delete>

    <resultMap id="attachmentMap" type="BoardAttachmentVO">
        <id column="ano" property="no" />
        <result column="bno" property="bno"/>
        <result column="filename" property="filename"/>
        <result column="path" property="path"/>
        <result column="contentType" property="contentType"/>
        <result column="size" property="size"/>
        <result column="a_reg_date" property="regDate"/>
    </resultMap>

    <resultMap id="boardMap" type="BoardVO">
        <id column="no" property="no"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="writer" property="writer"/>
        <result column="reg_date" property="regDate"/>
        <result column="update_date" property="updateDate"/>
        <collection property="attaches" resultMap="attachmentMap"/>
    </resultMap>
</mapper>